<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Tema mínimo basado en el tema de plataforma: Compose dibuja toda la interfaz,
        así que no se necesita AppCompat ni Material Components.
    -->
    <style name="Theme.Racion" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/racion_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
